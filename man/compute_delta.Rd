\description{
Test for a \strong{global} (antigen-wide) shift in peptide-level
prevalence between two groups within each \verb{(rank, feature, group_col)}
stratum by aggregating per-peptide effects into a single Stouffer-type
statistic and assessing significance via \strong{label permutation}.
}
\details{
For each stratum \verb{(rank, feature, group_col)} that defines an ordered pair of
groups \verb{(g1, g2)}, the procedure is:
\enumerate{
\item \strong{Peptide-level prevalences.}
For each peptide, prevalences in \code{g1} and \code{g2} are
\deqn{
     \hat p_k = \frac{x_k}{n_k},\quad k \in \{g1, g2\},
   }
where \code{x_k} is the number of samples with presence (\code{exist > 0}) and \code{n_k}
is the number of distinct samples (or paired subjects).
\item \strong{Per-peptide effect and z-score (\code{stat_mode}).}
\itemize{
\item \code{"diff"}: effect \eqn{\Delta = \hat p_{g2} - \hat p_{g1}} with
\deqn{
       SE = \sqrt{\hat p_{g1}(1 - \hat p_{g1}) / n_{g1} +
                  \hat p_{g2}(1 - \hat p_{g2}) / n_{g2}} ,
     }
and z-score \eqn{z = \Delta / SE} (with a small floor on \code{SE}).
\item \code{"asin"}: variance-stabilized difference of angles,
\deqn{
       z = \frac{\arcsin \sqrt{\hat p_{g2}} - \arcsin \sqrt{\hat p_{g1}}}
                {\sqrt{1 / (4 n_{g1}) + 1 / (4 n_{g2})}} .
     }
\item \code{"score"}: pooled score z for equality of proportions (2×2 score test),
using raw proportions \eqn{\tilde p_k = x_k / n_k} and pooled
\eqn{\tilde p = (x_1 + x_2)/(n_1 + n_2)}:
\deqn{
       z = \frac{\tilde p_{g2} - \tilde p_{g1}}
                {\sqrt{\tilde p(1-\tilde p)\left(1/n_{g1} + 1/n_{g2}\right)}} .
     }
\item \code{"srlr"}: signed root likelihood ratio for \eqn{H_0: p_{g1}=p_{g2}}:
\deqn{
       LR = 2\left[\ell(\hat p_{g1};x_1,n_1)+\ell(\hat p_{g2};x_2,n_2)
                 -\ell(\hat p;x_1,n_1)-\ell(\hat p;x_2,n_2)\right],
     }
\deqn{
       z = \mathrm{sign}(\hat p_{g2}-\hat p_{g1})\sqrt{LR},
     }
where \eqn{\ell(p;x,n)=x\log p+(n-x)\log(1-p)} and
\eqn{\hat p_{gk}=x_k/n_k}, \eqn{\hat p=(x_1+x_2)/(n_1+n_2)}.
\item \code{"mcnemar"} (paired-only): signed McNemar z based on discordant pairs
\eqn{b = \#(g1=1,g2=0)}, \eqn{c = \#(g1=0,g2=1)}:
\deqn{
       z = \frac{b - c}{\sqrt{b + c}} .
     }
If \eqn{b+c=0}, z is defined as 0.
\item \code{"srlr_paired"} (paired-only): signed root deviance for the paired
binomial problem with \eqn{m=b+c}:
\deqn{
       z = \mathrm{sign}(b-c)\sqrt{2\left[b\log\frac{2b}{m} + c\log\frac{2c}{m}\right]} .
     }
Terms with \eqn{0\log 0} are defined as 0; if \eqn{m=0}, z is 0.
}

Each \eqn{z_i} is then \strong{winsorized} to \eqn{\pm} \code{winsor_z}.
\item \strong{Weights (\code{weight_mode}).}
\itemize{
\item \code{"equal"}: all peptides get weight 1.
\item \code{"se_invvar"}: weights proportional to the inverse standard error
(or the analogous denominator for \code{"asin"}).
\item \code{"n_eff_sqrt"}:
\deqn{
       w_i = \sqrt{ n_{g1} \hat p_{g1} + n_{g2} \hat p_{g2} },
     }
i.e. the square root of the expected number of positives across both
groups.
}
\item \strong{Combine into a single test statistic (\code{aggregate_stat}).}
Let \eqn{w_i} be the weights and \eqn{z_i} the peptide-level z-scores.
\itemize{
\item If \code{aggregate_stat = "stouffer"} and \code{strat_bins = 0}:
\deqn{
       T_{\mathrm{obs}} =
         \frac{\sum_i w_i z_i}{\sqrt{\sum_i w_i^2}} .
     }
\item If \code{aggregate_stat = "stouffer"} and \code{strat_bins} is a numeric vector
of pooled prevalence cutpoints
(between 0 and 1), peptides are binned by pooled prevalence
\deqn{
       \frac{n_{g1}\hat p_{g1} + n_{g2}\hat p_{g2}}{n_{g1} + n_{g2}},
     }
a Stouffer statistic \eqn{T_b} is computed within each bin. The
\strong{mean} of the bin-level z-scores is reported as
\eqn{T_{\mathrm{obs}}}. For example, if \code{strat_bins} includes \code{0.10}
and \code{0.20}, then peptides with pooled prevalence in (0.10, 0.20] share
a bin.
}
\item \strong{Multiplicity.}
No multiple-testing correction is performed; \code{p_perm} is returned as
computed.
}

